---
import "@/styles/global.css";
import { About } from "@/components/About";
import { ClientLogos } from "@/components/ClientLogos";
import { Contact } from "@/components/Contact";
import { Footer } from "@/components/Footer";
import { Hero } from "@/components/Hero";
import { Navbar } from "@/components/Navbar";
import { Services } from "@/components/Services";
import { Materials } from "@/components/Materials";
import { getLandingPage } from "@/services/contentful";

const landingPage = await getLandingPage();
const siteConfig = landingPage.siteConfig?.siteConfig || landingPage.siteConfig;
const images = landingPage.images;
const seo = siteConfig.seo;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
  </head>
  <body>
    <Navbar client:load />
    <Hero client:load heroImage={images.hero} siteConfig={siteConfig} />
    <ClientLogos client:load clientLogos={images.clientLogos} />
    <About client:load aboutImage={images.about} certImage={images.certification} />
    <Services client:load />
    <Materials client:load />
    <Contact client:load />
    <Footer client:load siteConfig={siteConfig} />
  </body>
</html>
