---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href,
  ogImage,
  ogType = "website",
  noindex = false,
} = Astro.props;

const siteName = "Maestranza Tello-Astudillo";

// Generate OG-optimized image: 1200×630 crop via Cloudinary if it's a Cloudinary URL
const ogImageFormatted = ogImage?.includes("res.cloudinary.com")
  ? ogImage.replace(/\/upload\/[^/]+\//, "/upload/w_1200,h_630,c_fill,g_center,f_jpg,q_auto:good/")
  : ogImage;
---

<!-- Primary -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
<meta name="theme-color" content="#0a0f1a" />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="es_CL" />
{ogImageFormatted && <meta property="og:image" content={ogImageFormatted} />}
{ogImageFormatted && <meta property="og:image:width" content="1200" />}
{ogImageFormatted && <meta property="og:image:height" content="630" />}
{ogImageFormatted && <meta property="og:image:alt" content="Maestranza Tello-Astudillo — Mecanizado CNC y soldadura industrial en Chile" />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImageFormatted && <meta name="twitter:image" content={ogImageFormatted} />}
